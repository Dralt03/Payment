<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- ===== Project Identity ===== -->
    <groupId>com.payment</groupId>
    <artifactId>payment-platform</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>Payment Platform</name>
    <description>Production-grade payments system — Spring Boot 3</description>

    <!-- ===== Spring Boot Parent =====
         Inherits sensible defaults: plugin versions, dependency versions,
         UTF-8 encoding, Java source compatibility, etc.
         We DON'T need to specify individual library versions for managed deps. -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.2</version>
        <relativePath/>
    </parent>

    <properties>
        <java.version>21</java.version>
        <!-- Resilience4j version aligned with Spring Boot 3.x -->
        <resilience4j.version>2.2.0</resilience4j.version>
    </properties>

    <dependencies>

        <!-- ===== Web Layer =====
             Brings in Spring MVC + embedded Tomcat.
             This is what lets us write @RestController classes. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- ===== Database (JPA + Hibernate) =====
             Spring Data JPA gives us @Entity, @Repository, and JpaRepository.
             Hibernate is the ORM that translates our Java objects to SQL. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- ===== PostgreSQL Driver =====
             The JDBC driver that lets Java actually talk to PostgreSQL.
             'runtime' scope: needed at runtime but not at compile time. -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- ===== Flyway (Database Migrations) =====
             Flyway runs versioned SQL scripts (V1__, V2__, ...) on startup.
             This keeps your DB schema in sync across environments — no manual ALTER TABLE needed.
             We chose this over 'ddl-auto=create' because it's safe for production:
             it only adds/changes — never drops — unless you tell it to. -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>

        <!-- ===== Validation =====
             Lets us use @NotNull, @NotBlank, @DecimalMin etc. on DTOs.
             Spring will automatically validate incoming request bodies
             when we add @Valid on the controller method parameter. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- ===== Actuator =====
             Provides /actuator/health, /actuator/info, /actuator/metrics.
             Zero code needed — just adding this dependency turns them on.
             This is how ops teams know the service is alive. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- ===== Resilience4j (Circuit Breaker + Retry) =====
             We use this in Phase 4 for PSP retry logic and circuit breaking.
             Adding it now so the classpath is consistent from the start. -->
        <dependency>
            <groupId>io.github.resilience4j</groupId>
            <artifactId>resilience4j-spring-boot3</artifactId>
            <version>${resilience4j.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aop</artifactId>
        </dependency>

        <!-- ===== Lombok =====
             Generates boilerplate: @Getter, @Setter, @Builder, @AllArgsConstructor etc.
             This cuts entity/DTO files roughly in half. Processed at compile-time only,
             so it doesn't add any runtime overhead. -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- ===== Testing =====
             spring-boot-starter-test pulls in: JUnit 5, Mockito, AssertJ, MockMvc.
             This is everything we need for unit + integration tests. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <build>
        <plugins>
            <!-- ===== Spring Boot Maven Plugin =====
                 Lets us run: mvn spring-boot:run
                 Also packages the app into a single fat-jar: mvn package -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <!-- Exclude Lombok from the final jar — it's compile-time only -->
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
